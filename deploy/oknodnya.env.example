OKNO_BOT_TOKEN=
OKNO_CHANNEL=@oknodnya
# ваш chat_id: бот присылает сюда отчёт о сборке и ошибки (напишите боту /start, затем getUpdates)
OKNO_OWNER_CHAT=
OKNO_SITE_REPO=/opt/lofi-goroda-public
# голос: ключ ElevenLabs (elevenlabs.io → Profile → API keys). Пусто — озвучка RHVoice
OKNO_ELEVEN_KEY=
# папка, куда бот кладёт решения владельца по роликам (✅/⏭)
OKNO_APPROVALS=/opt/oknodnya-factory/approvals
