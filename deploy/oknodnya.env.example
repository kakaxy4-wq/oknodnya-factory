OKNO_BOT_TOKEN=
OKNO_CHANNEL=@oknodnya
# ваш chat_id: отчёт о сборке, превью роликов, ошибки и алерты (напишите боту /start, затем getUpdates)
OKNO_OWNER_CHAT=
OKNO_SITE_REPO=/opt/lofi-goroda-public
# голос: ключ ElevenLabs (elevenlabs.io → Profile → API keys). Пусто — озвучка RHVoice
OKNO_ELEVEN_KEY=
# папка, куда бот кладёт решения владельца по роликам (✅/⏭)
OKNO_APPROVALS=/opt/oknodnya-factory/approvals
# 1 — после сборки и QA-OK ролик одобряется сам: в approvals/ДАТА-N.ok пишется строка auto,
# владельцу уходит превью «выйдет в HH:MM» и кнопка «⏭ Пропустить».
# Пусто, 0 или любое другое значение — как раньше, в канал только после ✅.
# Алерты (сборка, QA, нет approved: true, ролик не вышел через 30 минут и в 23:30) работают и без флага.
OKNO_AUTO_PUBLISH=
